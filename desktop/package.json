{
  "name": "grand-theft-audi-desktop",
  "productName": "Grand Theft Audi",
  "version": "0.1.0",
  "private": true,
  "description": "Grand Theft Audi — open-world driving sandbox (desktop shell)",
  "main": "main.cjs",
  "author": "Neustadt Bay Team",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env GTA_DEV_URL=http://localhost:5173 electron .",
    "build:client": "cd ../client && npm run build",
    "dist:win": "npm run build:client && electron-builder --win",
    "dist:dir": "npm run build:client && electron-builder --dir"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "bay.neustadt.grandtheftaudi",
    "productName": "Grand Theft Audi",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "preload.cjs"],
    "extraResources": [
      { "from": "../client/dist", "to": "client" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
